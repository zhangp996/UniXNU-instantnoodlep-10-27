diff --git a/osfmk/ipc/ipc_pset.c b/osfmk/ipc/ipc_pset.c
index 33bc3f8..7369bb0 100644
--- a/osfmk/ipc/ipc_pset.c
+++ b/osfmk/ipc/ipc_pset.c
@@ -765,6 +765,16 @@ filt_machportattach(struct knote *kn, __unused struct kevent_qos_s *kev)
 
 	if (bits & MACH_PORT_TYPE_RECEIVE) {
 		kn->kn_filtid = EVFILTID_MACH_PORT;
+		/* Board bring-up: which process arms which port for kqueue, so a port that never sees its
+		 * queued message can be told from one that was never armed at all. */
+		{
+			ipc_port_t tp = ip_object_to_port(object);
+			ips_mq_lock((ipc_pset_t)tp);
+			printf("KNOTE attach pid=%d name=%x port=%p queue=%u\n",
+			    current_proc()->p_pid, (unsigned)name, (void *)tp,
+			    (unsigned)tp->ip_messages.imq_msgcount);
+			ip_mq_unlock(tp);
+		}
 		return filt_portattach(kn, ip_object_to_port(object));
 	}
 
