+/* Board publication policy for secondary CPUs: a CPU nub is registered only when
+ * sheng-smp is set and sheng-smp-core names that logical CPU, so cores can be brought
+ * up one at a time (one, three, four, ... eight) instead of all at once.  Unselected
+ * nubs keep their device-tree node but are detached from the parent.
+ */
+static unsigned native_smp_eligible, native_smp_withheld;
+extern "C" __attribute__((noinline)) bool
+native_smufs_cpu_nub_selected(int logical)
+{
+	unsigned smp = 0, core = 0;
+	PE_parse_boot_argn("sheng-smp", &smp, sizeof(smp));
+	bool have_core = PE_parse_boot_argn("sheng-smp-core", &core, sizeof(core)) != 0;
+	int boot = ml_get_boot_cpu_number();
+	unsigned maxcore = 0;
+	bool have_max = PE_parse_boot_argn("sheng-smp-max", &maxcore, sizeof(maxcore)) != 0;
+	bool selected = logical >= 0 &&
+	    (logical == boot ||
+	     (smp != 0 && have_max && logical <= static_cast<int>(maxcore)) ||
+	     (smp != 0 && have_core && logical == static_cast<int>(core)));
+	if (selected) {
+		__atomic_add_fetch(&native_smp_eligible, 1U, __ATOMIC_RELAXED);
+	} else {
+		__atomic_add_fetch(&native_smp_withheld, 1U, __ATOMIC_RELAXED);
+	}
+	return selected;
+}
