+static int
+konacon_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	char buf[64];
+
+	while (uio_resid(uio) > 0) {
+		size_t want = MIN(sizeof(buf), (size_t)uio_resid(uio));
+		int error = uiomove(buf, (int)want, uio);
+		if (error) {
+			return error;
+		}
+		for (size_t i = 0; i < want; i++) {
+			kona_early_putc(buf[i]);
+		}
+	}
+	return 0;
+}
