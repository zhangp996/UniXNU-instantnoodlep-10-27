+static struct {
+	uint8_t *base;
+	uint32_t stride, width, height, x, y;
+	int state;                              /* 0 = untried, 1 = ready, -1 = absent */
+} kona_con;
+
+/*
+ * xnu's own console record (osfmk/console/video_console.c): v_baseaddr is the
+ * virtual address it mapped the frame buffer at, and it is what
+ * scripts/xnu-panic-screen.c draws through. PE_state.video holds the physical
+ * base instead. The symbol is named through an assembler label so no header
+ * declaration can collide with it.
+ */
+struct kona_vc_info {
+	uint32_t v_height, v_width, v_depth, v_rowbytes;
+	uint64_t v_baseaddr;
+};
+extern char kona_vinfo[] __asm__("_vinfo");
+
+void
+kona_early_putc(char c)
+{
+	const uint32_t scale = 2, cell = 6 * scale, line = 14 * scale;
+	uint64_t glyph;
+	uint32_t top, bottom, row, col, dy, dx;
+
+	if (kona_con.state == 0) {
+		volatile struct kona_vc_info *v =
+		    (volatile struct kona_vc_info *)(void *)kona_vinfo;
+		vm_offset_t va;
+		kona_con.state = -1;
+		if (v->v_baseaddr && v->v_depth == 32 && v->v_rowbytes >= 64 && v->v_height > 200) {
+			/* Two wrong turns came first: PE_state.video.v_baseAddr is the physical
+			 * frame buffer, so drawing through it faulted at 0x9c00a8e0, and asking
+			 * ml_io_map for the whole panel panicked in kmem_alloc. This record is
+			 * already mapped, so nothing is mapped here. */
+			va = (vm_offset_t)v->v_baseaddr;
+			if (va) {
+				kona_con.base = (uint8_t *)va;
+				kona_con.stride = (uint32_t)v->v_rowbytes;
+				kona_con.width = (uint32_t)v->v_width;
+				kona_con.height = (uint32_t)v->v_height;
+				kona_con.x = 8;
+				kona_con.y = 8;
+				kona_con.state = 1;
+			}
+		}
+	}
+	if (kona_con.state != 1) {
+		return;
+	}
+	if (c == '\n') {
+		kona_con.x = 8;
+		kona_con.y += line;
+	} else if (c == '\r') {
+		kona_con.x = 8;
+	} else if (c >= 32 && c <= 126) {
+		if (kona_con.x + cell > kona_con.width) {
+			kona_con.x = 8;
+			kona_con.y += line;
+		}
+		glyph = kona_font[(unsigned char)c - 32];
+		top = (uint32_t)(glyph >> 32);
+		bottom = (uint32_t)glyph;
+		for (row = 0; row < 12; row++) {
+			uint32_t data = (row < 6) ? (top >> (row * 5)) : (bottom >> ((row - 6) * 5));
+			for (col = 0; col < 5; col++) {
+				if (!((data >> col) & 1)) {
+					continue;
+				}
+				for (dy = 0; dy < scale; dy++) {
+					for (dx = 0; dx < scale; dx++) {
+						*(volatile uint32_t *)(kona_con.base +
+						    (uint64_t)(kona_con.y + row * scale + dy) * kona_con.stride +
+						    (uint64_t)(kona_con.x + col * scale + dx) * 4) = 0xFFFFFFFFu;
+					}
+				}
+			}
+		}
+		kona_con.x += cell;
+	}
+	if (kona_con.y + line > kona_con.height) {
+		kona_con.x = 8;
+		kona_con.y = 8;
+	}
+}
