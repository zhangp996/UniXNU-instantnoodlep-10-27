+static int
+kona_ufs_init(void)
+{
+	DTEntry node;
+	const void *prop = NULL;
+	uint64_t reg[2] = { UFS_MMIO_BASE, UFS_MMIO_SIZE };
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	su.stage = "dt";
+	/* The curated ADT this board boots does not carry /kona-ufs; the measured
+	 * controller window is the default and a DT node may override it. */
+	if (SecureDTLookupEntry(NULL, "/kona-ufs", &node) == kSuccess &&
+	    SecureDTGetProperty(node, "reg", &prop, &size) == kSuccess &&
+	    size == sizeof(reg)) {
+		memcpy(reg, prop, sizeof(reg));
+	}
+	if (reg[0] != UFS_MMIO_BASE || reg[1] < UFS_MMIO_SIZE) {
+		printf("KONA UFS: invalid UFS window 0x%llx+0x%llx\n", reg[0], reg[1]);
+		return ENXIO;
+	}
+	su.stage = "arg";
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	want[sizeof(want) - 1] = 0;
+	if (want[0] == 0 || strlen(want) > 36) {
+		return EINVAL;
+	}
+
+	su.stage = "map";
+	su.regs = ml_io_map((vm_offset_t)reg[0], UFS_MMIO_SIZE);
+	if (!su.regs) {
+		return ENOMEM;
+	}
+	su.stage = "ver";
+	uint32_t ver = ufs_rd(REG_VER), cap = ufs_rd(REG_CAP);
+	printf("KONA UFS: VER 0x%x CAP 0x%x HCE 0x%x HCS 0x%x\n",
+	    ver, cap, ufs_rd(REG_HCE), ufs_rd(REG_HCS));
+	/* 1.x command types differ; 4.x/MCQ and unknown versions are not handled. */
+	if (ver != 0x200 && ver != 0x210 && ver != 0x300 && ver != 0x310) {
+		/* kona reports the DWC host version (0x1587031F), not the UFSHCI 2.x/3.x
+		 * minor; the legacy UTRL layout is still the one the bootloader used. */
+		printf("KONA UFS: UFSHCI VER 0x%x, continuing with the legacy list\n", ver);
+	}
+	su.stage = "page";
+	if (PAGE_SIZE != 0x1000 && PAGE_SIZE != 0x4000) {
+		printf("KONA UFS: unsupported kernel page size 0x%x\n", (unsigned)PAGE_SIZE);
+		return ENXIO;
+	}
+	su.stage = "dma";
+	ppnum_t max_pnum = (cap & CAP_64AS) ? 0 : (ppnum_t)atop_64(UINT32_MAX);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, max_pnum, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("KONA UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	if ((su.dma & PAGE_MASK) || (su.dma_pa & PAGE_MASK) ||
+	    (!(cap & CAP_64AS) && su.dma_pa + DMA_SIZE - 1 > UINT32_MAX)) {
+		return EINVAL;
+	}
+	/* kmem_alloc_contig wires contiguous pages; verify before publishing DMA. */
+	for (vm_size_t off = 0; off < DMA_SIZE; off += PAGE_SIZE) {
+		ppnum_t page = pmap_find_phys(kernel_pmap, (addr64_t)(su.dma + off));
+		if (!page || ptoa_64(page) != su.dma_pa + off) {
+			printf("KONA UFS: noncontiguous DMA allocation\n");
+			return ENOMEM;
+		}
+	}
+	printf("KONA UFS: DMA PA 0x%llx size 0x%x (firmware must allow physical DMA)\n",
+	    su.dma_pa, DMA_SIZE);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	/*
+	 * Writes stay off unless asked for: the bring-up path only reads, and a
+	 * stray write would destroy the volume this kernel is running from.
+	 */
+	uint32_t ufsrw = 0;
+	if (PE_parse_boot_argn("ufsrw", &ufsrw, sizeof(ufsrw)) && ufsrw) {
+		su.writable = true;
+	}
+
+	su.stage = "host";
+	error = ufs_take_over_host();
+	if (!error) {
+		/* UFS-PowerDown (0x33) leaves every LU NOT READY; the device wakes
+		 * with START STOP UNIT, power condition ACTIVE, to well-known LU 0xD0
+		 * (ShengUfs NativeUfs.cpp and Linux ufshcd_set_dev_pwr_mode). */
+		static const uint8_t start[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+		uint32_t saved_lun = su.lun;
+		su.lun = 0xd0;
+		ufs_scsi(start, sizeof(start), 0, false);
+		su.lun = saved_lun;
+		delay(50000);
+		su.stage = "tur";
+		static const uint8_t tur[6] = { 0x00 };
+		for (int i = 0; i < 20; i++) {
+			error = ufs_scsi(tur, sizeof(tur), 0, false);
+			if (!error) {
+				break;
+			}
+			delay(10000);
+		}
+	}
+	su.stage = "capacity";
+	if (!error) {
+		error = ufs_read_capacity();
+	}
+	su.stage = "partition";
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	if (error) {
+		return error;
+	}
+
+	su.stage = "bdevsw";
+	su.bmajor = bdevsw_add(-1, &kona_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &kona_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		bdevsw_remove(su.bmajor, &kona_ufs_bdevsw);
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	void *block_node = devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0440, "ufsroot0");
+	void *char_node = devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0440, "rufsroot0");
+
+	/*
+	 * The write-only console, so userland has somewhere to print before the
+	 * tty layer works.
+	 */
+	su.conmajor = cdevsw_add(-1, &konacon_cdevsw);
+	if (su.conmajor >= 0) {
+		void *con_node = devfs_make_node(makedev(su.conmajor, 0), DEVFS_CHAR,
+		    UID_ROOT, GID_WHEEL, 0666, "konacon");
+		if (con_node == NULL) {
+			cdevsw_remove(su.conmajor, &konacon_cdevsw);
+			su.conmajor = -1;
+		}
+	}
+	printf("KONA UFS: /dev/konacon %s\n", su.conmajor >= 0 ? "ready" : "unavailable");
+	if (!block_node || !char_node) {
+		if (block_node) {
+			devfs_remove(block_node);
+		}
+		if (char_node) {
+			devfs_remove(char_node);
+		}
+		cdevsw_remove(su.cmajor, &kona_ufs_cdevsw);
+		bdevsw_remove(su.bmajor, &kona_ufs_bdevsw);
+		return ENOMEM;
+	}
+	su.ready = true;
+	{
+		static const char kona_banner[] = "konacon: framebuffer console ready\n";
+		const char *kona_p;
+		for (kona_p = kona_banner; *kona_p; kona_p++) {
+			kona_early_putc(*kona_p);
+		}
+	}
+	kona_cp(2);
+	{
+		int konacp_want = 0;
+		const uint8_t *kona_b;
+		if (PE_parse_boot_argn("konacp", &konacp_want, sizeof(konacp_want)) && konacp_want == 9) {
+			error = ufs_read_blocks(su.first_block, 1);
+			kona_b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+			panic("kona cp 9: err %d blk0 %02x %02x %02x %02x magic %02x %02x %02x %02x",
+			    error, kona_b[0], kona_b[1], kona_b[2], kona_b[3],
+			    kona_b[32], kona_b[33], kona_b[34], kona_b[35]);
+		}
+	}
+	printf("KONA UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, read-only\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20);
+	return 0;
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int kona_ufs_rootdev(dev_t *dev);
+
+int
+kona_ufs_rootdev(dev_t *dev)
+{
+	kona_cp(1);
+	/* The vendored Apple OSS HFS has no kext: register it before vfs_mountroot walks
+	 * vfsconf. This runs from IOFindBSDRoot, which is earlier than the mount. */
+	extern void kona_hfs_register(void);
+	kona_hfs_register();
+
+	lck_mtx_lock(&kona_ufs_lock);
+	if (!su.init_attempted) {
+		su.init_attempted = true;
+		su.init_error = kona_ufs_init();
+	}
+	int error = su.init_error;
+	if (!error) {
+		*dev = su.bdev;
+	} else {
+		panic("KONA UFS %s failed: %d [%s]", su.stage ? su.stage : "init", error, su.detail);
+	}
+	lck_mtx_unlock(&kona_ufs_lock);
+	return error;
+}
+#endif /* KONA */
