--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -96,3 +96,5 @@
 #include <sys/vnode_internal.h>
+static uint32_t kona_hdr_magic, kona_hdr_cpu, kona_hdr_ft, kona_hdr_ncmds, kona_hdr_cmds;
+static int kona_hdr_resid;
 #include <sys/file_internal.h>
 #include <sys/stat.h>
@@ -7027,6 +7029,23 @@
 	assert(p);
 	assert(scratch_addr);
 	assert(path);
+	{
+		vnode_t kona_vp = NULL;
+		char kona_hdr[32] = {0};
+		kona_hdr_resid = 0;
+		if (vnode_lookup(path, 0, &kona_vp, vfs_context_kernel()) == 0) {
+			(void)vn_rdwr(UIO_READ, kona_vp, kona_hdr, sizeof(kona_hdr), 0,
+			    UIO_SYSSPACE, 0, vfs_context_kernel(), &kona_hdr_resid);
+			vnode_put(kona_vp);
+			memcpy(&kona_hdr_magic, kona_hdr, 4);
+			memcpy(&kona_hdr_cpu, kona_hdr + 4, 4);
+			memcpy(&kona_hdr_ft, kona_hdr + 12, 4);
+			memcpy(&kona_hdr_ncmds, kona_hdr + 16, 4);
+			memcpy(&kona_hdr_cmds, kona_hdr + 20, 4);
+		}
+	}
 
 	/*
 	 * Copy out program name.
@@ -7195,3 +7214,5 @@
 	}
 
-	panic("Process 1 exec of %s failed, errno %d", ((i == 0) ? "<null>" : init_programs[i - 1]), error);
+	panic("Process 1 exec of %s failed, errno %d magic %08x cpu %08x ft %u ncmds %u cmds %u resid %d",
+	    ((i == 0) ? "<null>" : init_programs[i - 1]), error,
+	    kona_hdr_magic, kona_hdr_cpu, kona_hdr_ft, kona_hdr_ncmds, kona_hdr_cmds, kona_hdr_resid);
