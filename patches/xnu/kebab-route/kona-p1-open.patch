diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -5128,10 +5128,29 @@
 	return open_nocancel(p, (struct open_nocancel_args *)uap, retval);
 }
 
+char native_p1_path[128];
+unsigned long native_p1_path_len = 0;
+
+static void
+native_p1_note_open(proc_t p, user_addr_t path)
+{
+	/* The last path PID 1 opened. dyld reads the shared cache through here, and this names the
+	 * step it reached when it leaves after printing only its dyld[%d]: prefix. */
+	if (proc_getpid(p) != 1) {
+		return;
+	}
+	size_t taken = 0;
+	if (copyinstr(path, native_p1_path, sizeof(native_p1_path) - 1, &taken) == 0) {
+		native_p1_path[taken] = 0;
+		native_p1_path_len = taken;
+	}
+}
+
 int
 open_nocancel(__unused proc_t p, struct open_nocancel_args *uap,
     int32_t *retval)
 {
+	native_p1_note_open(p, uap->path);
 	return openat_internal(vfs_context_current(), uap->path, uap->flags,
 	           uap->mode, AT_FDCWD, UIO_USERSPACE, retval);
 }
@@ -5140,6 +5159,7 @@
 openat_nocancel(__unused proc_t p, struct openat_nocancel_args *uap,
     int32_t *retval)
 {
+	native_p1_note_open(p, uap->path);
 	return openat_internal(vfs_context_current(), uap->path, uap->flags,
 	           uap->mode, uap->fd, UIO_USERSPACE, retval);
 }
