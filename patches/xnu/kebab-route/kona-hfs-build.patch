--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -591,3 +591,40 @@
 
 include $(MakeInc_rule)
 include $(MakeInc_dir)
+
+# KONA: compile the vendored Apple OSS HFS (bsd/kona_hfs) with its KPI header view.
+ifeq ($(CURRENT_MACHINE_CONFIG),BCM2837)
+KONA_HFS_ROOT = $(SRCROOT)/bsd/kona_hfs
+KONA_HFS_OBJS = BTree.o BTreeAllocate.o BTreeMiscOps.o BTreeNodeOps.o BTreeNodeReserve.o BTreeScanner.o BTreeTreeOps.o BTreeWrapper.o CatalogUtilities.o FileExtentMapping.o FileIDsServices.o MacOSStubs.o UnicodeWrappers.o VolumeAllocation.o hfs_attrlist.o hfs_btreeio.o hfs_catalog.o hfs_chash.o hfs_cnode.o hfs_cprotect.o hfs_endian.o hfs_extents.o hfs_fsinfo.o hfs_hotfiles.o hfs_journal.o hfs_link.o hfs_lookup.o hfs_notification.o hfs_quota.o hfs_readwrite.o hfs_resize.o hfs_search.o hfs_vfsops.o hfs_vfsutils.o hfs_vnops.o hfs_xattr.o rangelist.o hfs_encodinghint.o hfs_encodings.o kona_hfs_iokit.o
+$(foreach o,$(KONA_HFS_OBJS),$(eval $(o)_CFLAGS_ADD += -include $(KONA_HFS_ROOT)/kona_hfs_compat.h -I$(KONA_HFS_ROOT) -I$(KONA_HFS_ROOT)/core))
+hfs_encodings.o_CFLAGS_ADD += -Dhfs_allocated=hfs_encodings_allocated
+hfs_encodinghint.o_CFLAGS_ADD += -Dhfs_allocated=hfs_encodings_allocated
+hfs_catalog.o_CWARNFLAGS_ADD += -Wno-implicit-fallthrough
+hfs_encodings.o_CWARNFLAGS_ADD += -Wno-unreachable-code-break
+BTree.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion
+BTreeAllocate.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion -Wno-shorten-64-to-32
+BTreeMiscOps.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-unused-but-set-variable
+BTreeNodeOps.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion
+BTreeNodeReserve.o_CWARNFLAGS_ADD += -Wno-shorten-64-to-32
+BTreeScanner.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion
+BTreeTreeOps.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion -Wno-unused-but-set-variable
+BTreeWrapper.o_CWARNFLAGS_ADD += -Wno-implicit-int-conversion
+CatalogUtilities.o_CWARNFLAGS_ADD += -Wno-implicit-int-conversion -Wno-misleading-indentation -Wno-shorten-64-to-32
+FileExtentMapping.o_CWARNFLAGS_ADD += -Wno-implicit-int-conversion -Wno-shorten-64-to-32
+FileIDsServices.o_CWARNFLAGS_ADD += -Wno-implicit-int-conversion
+hfs_attrlist.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-deprecated-non-prototype -Wno-implicit-int-conversion -Wno-shorten-64-to-32 -Wno-unused-but-set-variable
+hfs_btreeio.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion -Wno-misleading-indentation -Wno-shorten-64-to-32
+hfs_catalog.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion -Wno-shorten-64-to-32 -Wno-unused-but-set-variable -Wno-unused-parameter
+hfs_cnode.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion -Wno-shorten-64-to-32 -Wno-unused-but-set-variable
+hfs_encodings.o_CWARNFLAGS_ADD += -Wno-implicit-int-conversion -Wno-shorten-64-to-32
+hfs_endian.o_CWARNFLAGS_ADD += -Wno-cast-align
+hfs_extents.o_CWARNFLAGS_ADD += -Wno-implicit-int-conversion
+hfs_fsinfo.o_CWARNFLAGS_ADD += -Wno-implicit-int-conversion
+hfs_hotfiles.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion -Wno-shorten-64-to-32 -Wno-unused-but-set-variable
+hfs_journal.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-cast-qual -Wno-global-constructors -Wno-implicit-int-conversion -Wno-shorten-64-to-32 -Wno-unused-but-set-variable
+hfs_link.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion -Wno-shorten-64-to-32 -Wno-unused-but-set-variable
+hfs_lookup.o_CWARNFLAGS_ADD += -Wno-implicit-int-conversion
+hfs_readwrite.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion -Wno-shorten-64-to-32 -Wno-unused-but-set-variable
+hfs_resize.o_CWARNFLAGS_ADD += -Wno-implicit-int-conversion -Wno-shorten-64-to-32
+hfs_vfsops.o_CWARNFLAGS_ADD += -Wno-cast-align -Wno-implicit-int-conversion -Wno-shorten-64-to-32 -Wno-unused-parameter -Wno-unused-variable
+endif
