diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8200,6 +8200,21 @@
 	int policy_error=sheng_boot_watchdog_policy(p, (uint64_t)scratch_addr);
 	if (policy_error) panic("sheng watchdog launch policy failed: %d", policy_error);
 	boot_progress_stage("temporary watchdog launch policy ready");
+	{
+		// Which cryptex path actually holds the dyld shared cache? The kernel points dyld at
+		// /private/preboot/System/... while the system volume links /System/Cryptexes/OS to
+		// ../../private/preboot/Cryptexes/OS, so both are looked up and reported as cache a= b=.
+		vnode_t kona_cache_vp = NULL;
+		char konatrace[64];
+		int kona_a = vnode_lookup("/private/preboot/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64e",
+		                          0, &kona_cache_vp, vfs_context_current());
+		if (kona_cache_vp) { vnode_put(kona_cache_vp); kona_cache_vp = NULL; }
+		int kona_b = vnode_lookup("/private/preboot/Cryptexes/OS/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64e",
+		                          0, &kona_cache_vp, vfs_context_current());
+		if (kona_cache_vp) { vnode_put(kona_cache_vp); }
+		snprintf(konatrace, sizeof(konatrace), "cache a=%d b=%d", kona_a, kona_b);
+		boot_progress_stage(konatrace);
+	}
 #endif
 #endif
 #if CONFIG_MEMORYSTATUS
