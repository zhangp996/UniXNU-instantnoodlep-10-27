diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8200,6 +8200,30 @@
 	int policy_error=sheng_boot_watchdog_policy(p, (uint64_t)scratch_addr);
 	if (policy_error) panic("sheng watchdog launch policy failed: %d", policy_error);
 	boot_progress_stage("temporary watchdog launch policy ready");
+	{
+		// The cryptex root resolves System and usr, so the volume is mounted and readable, but the
+		// cache file was not found. Walk one level at a time to tell a sealed-volume traversal
+		// limit apart from a volume that simply does not carry the cache.
+		vnode_t kona_vp = NULL;
+		char konatrace[96];
+		static const char *const kona_paths[] = {
+			"/private/preboot/System/Library",
+			"/private/preboot/System/Library/Caches",
+			"/private/preboot/System/Library/Caches/com.apple.dyld",
+			"/private/preboot/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64e",
+			"/private/preboot/usr/lib",
+			"/private/preboot/Applications",
+		};
+		int kona_e[6];
+		for (int kona_i = 0; kona_i < 6; kona_i++) {
+			kona_e[kona_i] = vnode_lookup(kona_paths[kona_i], 0, &kona_vp, vfs_context_current());
+			if (kona_vp) { vnode_put(kona_vp); kona_vp = NULL; }
+		}
+		snprintf(konatrace, sizeof(konatrace), "walk g=%d h=%d i=%d", kona_e[0], kona_e[1], kona_e[2]);
+		boot_progress_stage(konatrace);
+		snprintf(konatrace, sizeof(konatrace), "walk2 j=%d k=%d l=%d", kona_e[3], kona_e[4], kona_e[5]);
+		boot_progress_stage(konatrace);
+	}
 #endif
 #endif
 #if CONFIG_MEMORYSTATUS
