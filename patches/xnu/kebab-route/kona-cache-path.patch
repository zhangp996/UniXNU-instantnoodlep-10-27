diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8200,6 +8200,31 @@
 	int policy_error=sheng_boot_watchdog_policy(p, (uint64_t)scratch_addr);
 	if (policy_error) panic("sheng watchdog launch policy failed: %d", policy_error);
 	boot_progress_stage("temporary watchdog launch policy ready");
+	{
+		// Neither candidate cache path exists, so the cryptex volume is either not the volume the
+		// policy names or has a different root layout. Report the device the mount used plus four
+		// marker directories: the dyld cache directory, Cryptexes, private (an OS-root marker) and
+		// db (a Data-root marker).
+		vnode_t kona_vp = NULL;
+		char konatrace[96];
+		struct {
+			const char *path;
+		} kona_paths[4] = {
+			{ "/private/preboot/System/Library/Caches/com.apple.dyld" },
+			{ "/private/preboot/Cryptexes" },
+			{ "/private/preboot/private" },
+			{ "/private/preboot/db" },
+		};
+		int kona_e[4];
+		for (int kona_i = 0; kona_i < 4; kona_i++) {
+			kona_e[kona_i] = vnode_lookup(kona_paths[kona_i].path, 0, &kona_vp, vfs_context_current());
+			if (kona_vp) { vnode_put(kona_vp); kona_vp = NULL; }
+		}
+		snprintf(konatrace, sizeof(konatrace), "cryptex %.20s", native_owner_cache_device_path);
+		boot_progress_stage(konatrace);
+		snprintf(konatrace, sizeof(konatrace), "cache a=%d b=%d c=%d d=%d", kona_e[0], kona_e[1], kona_e[2], kona_e[3]);
+		boot_progress_stage(konatrace);
+	}
 #endif
 #endif
 #if CONFIG_MEMORYSTATUS
