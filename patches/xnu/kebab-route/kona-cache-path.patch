diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8200,6 +8200,34 @@
 	int policy_error=sheng_boot_watchdog_policy(p, (uint64_t)scratch_addr);
 	if (policy_error) panic("sheng watchdog launch policy failed: %d", policy_error);
 	boot_progress_stage("temporary watchdog launch policy ready");
+	{
+		// Local reading of the OS volume says /System/Library/Caches/com.apple.dyld does not exist
+		// there and /private/preboot is an empty directory, so these markers name the volume that
+		// actually answered the mount: System and usr if the cryptex root is the OS tree, private if
+		// the root volume was mounted by mistake, db if the Data seed was, plus the two places a
+		// shared cache can live inside a cryptex.
+		vnode_t kona_vp = NULL;
+		char konatrace[96];
+		static const char *const kona_paths[] = {
+			"/private/preboot/System",
+			"/private/preboot/usr",
+			"/private/preboot/private",
+			"/private/preboot/db",
+			"/private/preboot/System/Library/dyld",
+			"/private/preboot/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64e",
+		};
+		int kona_e[6];
+		for (int kona_i = 0; kona_i < 6; kona_i++) {
+			kona_e[kona_i] = vnode_lookup(kona_paths[kona_i], 0, &kona_vp, vfs_context_current());
+			if (kona_vp) { vnode_put(kona_vp); kona_vp = NULL; }
+		}
+		snprintf(konatrace, sizeof(konatrace), "cryptex %.22s", native_owner_cache_device_path);
+		boot_progress_stage(konatrace);
+		snprintf(konatrace, sizeof(konatrace), "cache a=%d b=%d c=%d", kona_e[0], kona_e[1], kona_e[2]);
+		boot_progress_stage(konatrace);
+		snprintf(konatrace, sizeof(konatrace), "cache2 d=%d e=%d f=%d", kona_e[3], kona_e[4], kona_e[5]);
+		boot_progress_stage(konatrace);
+	}
 #endif
 #endif
 #if CONFIG_MEMORYSTATUS
