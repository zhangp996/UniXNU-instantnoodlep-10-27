 	    &native_gpu_addon_status);
+	/* A job of our own on top of the system daemons: the union below shadows any name it carries, so a
+	 * copy of com.apple.chronod.plist with RunAtLoad makes launchd start the service whose absence keeps
+	 * SpringBoard blocked in its synchronous ChronoServices subscription. */
+	{
+		static const char chronod_job[] =
+		    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+		    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+		    "<plist version=\"1.0\"><dict>"
+		    "<key>Label</key><string>com.apple.chronod</string>"
+		    "<key>ProgramArguments</key><array><string>/System/Library/PrivateFrameworks/ChronoCore.framework/Support/chronod</string></array>"
+		    "<key>MachServices</key><dict><key>com.apple.chronoservices</key><true/>"
+		    "<key>com.apple.chrono.widgetcenterconnection</key><true/></dict>"
+		    "<key>UserName</key><string>mobile</string>"
+		    "<key>RunAtLoad</key><true/>"
+		    "<key>KeepAlive</key><dict><key>Crashed</key><true/></dict>"
+		    "<key>POSIXSpawnType</key><string>Interactive</string>"
+		    "</dict></plist>\n";
+		native_launchd_overlay("com.apple.chronod", chronod_job, sizeof(chronod_job) - 1);
+		/* A job with a label of our own: it shadows nothing, so it tells whether launchd reads this
+		 * directory at all, separately from the question of the system label. */
+		static const char boot_job[] =
+		    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+		    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+		    "<plist version=\"1.0\"><dict>"
+		    "<key>Label</key><string>com.unixnu.chronodboot</string>"
+		    "<key>ProgramArguments</key><array><string>/System/Library/PrivateFrameworks/ChronoCore.framework/Support/chronod</string></array>"
+		    "<key>MachServices</key><dict><key>com.unixnu.chronodboot</key><true/></dict>"
+		    "<key>UserName</key><string>mobile</string>"
+		    "<key>RunAtLoad</key><true/>"
+		    "<key>KeepAlive</key><dict><key>Crashed</key><true/></dict>"
+		    "<key>POSIXSpawnType</key><string>Interactive</string>"
+		    "</dict></plist>\n";
+		native_launchd_overlay("com.unixnu.chronodboot", boot_job, sizeof(boot_job) - 1);
+	}
 	native_gpu_addon_mount(p, scratch, 0x600, daemons_source, sizeof(daemons_source), daemons_point, sizeof(daemons_point),
 	    "/System/Library/LaunchDaemons/com.apple.backboardd.plist",
 	    "/System/Library/LaunchDaemons/org.blu-sharky.adrenoprobed.plist", &native_gpu_addon2_stage, &native_gpu_addon2_status);
