+/* Create one directory if it is not there yet. */
+static void
+native_gpu_addon_mkdir(const char *parent_path, const char *leaf, vfs_context_t ctx)
+{
+	struct componentname cn;
+	struct vnode_attr va;
+	vnode_t dvp = NULLVP, sdvp = NULLVP;
+
+	if (vnode_lookup(parent_path, 0, &dvp, ctx)) {
+		return;
+	}
+	bzero(&cn, sizeof(cn));
+	cn.cn_nameiop = CREATE;
+	cn.cn_flags = ISLASTCN;
+	cn.cn_pnbuf = (char *)(uintptr_t)leaf;
+	cn.cn_pnlen = (int)strlen(leaf);
+	cn.cn_nameptr = cn.cn_pnbuf;
+	cn.cn_namelen = (int)strlen(leaf);
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_uid, 0);
+	VATTR_SET(&va, va_gid, 0);
+	VATTR_SET(&va, va_mode, 0755);
+	VATTR_SET(&va, va_type, VDIR);
+	if (VNOP_MKDIR(dvp, &sdvp, &cn, &va, ctx) == 0) {
+		vnode_put(sdvp);
+	}
+	vnode_put(dvp);
+}
+
+/* Write one job definition into the directory the daemons union shadows. */
+static void
+native_launchd_overlay(const char *name, const char *body, size_t length)
+{
+	static const char dir[] = "/private/var/ngpu/daemons";
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP, dvp = NULLVP;
+	char path[128];
+	int error;
+
+	native_gpu_addon_mkdir("/private/var", "ngpu", ctx);
+	native_gpu_addon_mkdir("/private/var/ngpu", "daemons", ctx);
+	if (vnode_lookup(dir, 0, &dvp, ctx)) {
+		printf("launchd overlay: %s missing\n", dir);
+		return;
+	}
+	vnode_put(dvp);
+	snprintf(path, sizeof(path), "%s/%s.plist", dir, name);
+	error = vnode_open(path, FWRITE | O_CREAT | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		printf("launchd overlay: open %s failed %d\n", path, error);
+		return;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)body, (int)length, 0, UIO_SYSSPACE,
+	    IO_NODELOCKED, vfs_context_ucred(ctx), NULL, current_proc());
+	if (!error) {
+		(void)VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	(void)vnode_close(vp, FWRITE, ctx);
+	printf("launchd overlay: %s written (%d)\n", path, error);
+	/* Read the shadowed name back through the mount: if the union took effect this is our copy. */
+	{
+		vnode_t check = NULLVP;
+		char sample[64] = {0};
+		if (!vnode_open("/System/Library/LaunchDaemons/com.apple.chronod.plist", FREAD, 0, 0, &check, ctx)) {
+			uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+			if (uio) {
+				uio_addiov(uio, CAST_USER_ADDR_T(sample), sizeof(sample) - 1);
+				(void)VNOP_READ(check, uio, 0, ctx);
+				uio_free(uio);
+			}
+			vnode_close(check, FREAD, ctx);
+			sample[sizeof(sample) - 1] = 0;
+			printf("launchd overlay check: %.48s\n", sample);
+		} else {
+			printf("launchd overlay check: open failed\n");
+		}
+	}
+}
