--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -102,6 +102,16 @@
 static void
 check_for_panic_log(void)
 {
+	/*
+	 * Device: ml_io_map_* before the kernel VM exists takes io_map()'s static
+	 * branch, where virtual_space_start is still zero, so the region would be
+	 * mapped at virtual address 0. The DT region is armed again from
+	 * PE_initialize_console() once kernel_map exists.
+	 */
+	if (kernel_map == VM_MAP_NULL) {
+		return;
+	}
+
 #if defined(PLATFORM_PANIC_LOG_PADDR) && !(defined(XNU_DT_PANIC_REGION) && XNU_DT_PANIC_REGION)
 	gPanicBase = ml_io_map_wcomb(PLATFORM_PANIC_LOG_PADDR, PLATFORM_PANIC_LOG_SIZE);
 	panic_text_len = PLATFORM_PANIC_LOG_SIZE - sizeof(struct embedded_panic_header);
