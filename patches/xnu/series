# Board patch paths, one per line in application order.
#
# Kebab bdevsw route (docs/kebab-path-analysis.md): a BSD-level UFS disk publishes ufsroot0
# without IOStorageFamily, and IOKitBSDInit's rd=ufsroot0 hook selects it. The HFS patches in
# kebab-route/ stay unapplied: iPadOS roots on APFS, which is already in the prelinked kernel.
kebab-route/kona-ufs-driver.patch
# kona_early_putc now lives in the driver patch: it draws through the kernel frame
# buffer mapping, so the separate no-op stub (kona-ufs-early-putc.patch) is gone.
kebab-route/kona-hfs-noop.patch
kebab-route/kona-ufs-integration.patch
kebab-route/kona-rootauth-bypass.patch
# konacp 5-8: bsd_init checkpoints around net_init_run/inittodr/vfs_mountroot.
kebab-route/kona-mountroot-cp.patch
# konacp 10: list the filesystems that carry a mountroot routine.
kebab-route/kona-vfs-cp.patch
