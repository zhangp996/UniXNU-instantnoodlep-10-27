+/* The deletable built-in system apps (Weather, Notes, Calendar, Files, Reminders, Maps, ...) live in the OS
+ * volume's /private/var/staged_system_apps.  Union that directory over /Applications before the Data volume
+ * covers /private/var, so LaunchServices and SpringBoard see every built-in app and its home-screen widget
+ * immediately instead of the placeholders alone (the reference board's approach). */
+static void
+native_staged_apps_union(proc_t p, user_addr_t scratch)
+{
+	static const char source[] = "/private/var/staged_system_apps", point[] = "/Applications";
+	static volatile int stage, status;
+	native_gpu_addon_mount(p, scratch, 0x800, source, sizeof(source), point, sizeof(point),
+	    "/Applications/Preferences.app/Info.plist",
+	    "/Applications/Weather.app/Info.plist",
+	    &stage, &status);
+	printf("staged-apps union: stage=%d status=%d\n", stage, status);
+}
+
 static int
 native_owner_data_prepare(proc_t p, user_addr_t scratch)
 {
+	native_staged_apps_union(p, scratch);
 	uint64_t base = 0, size = 0;
 	dev_t device = NODEV;
 	int error = EINVAL;
