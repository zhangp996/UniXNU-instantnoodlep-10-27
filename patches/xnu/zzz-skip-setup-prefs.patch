+/* Runtime equivalent of --skip-setup: seed-data-skip-setup.py merges these preference domains into
+ * the Data seed before boot.  The Linux build host cannot run hdiutil, so the same five domains are
+ * written here instead, before launchd starts, into /private/var/mobile/Library/Preferences. */
+static void
+native_pref_write(const char *name, const char *body, size_t length)
+{
+	static const char dir[] = "/private/var/mobile/Library/Preferences";
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP, dvp = NULLVP;
+	char path[160];
+	int error;
+
+	native_gpu_addon_mkdir("/private/var", "mobile", ctx);
+	native_gpu_addon_mkdir("/private/var/mobile", "Library", ctx);
+	native_gpu_addon_mkdir("/private/var/mobile/Library", "Preferences", ctx);
+	if (vnode_lookup(dir, 0, &dvp, ctx)) {
+		printf("skip-setup: %s missing\n", dir);
+		return;
+	}
+	vnode_put(dvp);
+	if (snprintf(path, sizeof(path), "%s/%s.plist", dir, name) >= (int)sizeof(path)) {
+		return;
+	}
+	error = vnode_open(path, FWRITE | O_CREAT | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		printf("skip-setup: %s open %d\n", name, error);
+		return;
+	}
+	(void)vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)body, (int)length, 0, UIO_SYSSPACE,
+	    IO_NODELOCKED, vfs_context_ucred(ctx), NULL, current_proc());
+	(void)VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	(void)vnode_close(vp, FWRITE, ctx);
+	printf("skip-setup: %s written\n", name);
+}
