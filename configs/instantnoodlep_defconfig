# Board configuration. docs/porting/device-repository.md: the arch, SoC and OS
# fragments apply first and this file last, so only board differences belong here.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# SM8250 (kona) implements ARMv8.1 PAN, so the exception entry must manage it.
CONFIG_XNU_NATIVE_PAN=y
# docs/guide/debugging.md: read the embedded panic region from the device tree instead
# of the board header constant the arch profile otherwise compiles in.
CONFIG_XNU_DT_PANIC_REGION=y
# Storage: only the IOStorageFamily route remains. The old kebab bdevsw driver
# (bsd/dev/kona_ufs.c, CONFIG_XNU_KONA_UFS) is gone: it published a BSD disk with no IOMedia,
# which docs/porting/ufs.md records as a root that APFS declines before issuing a request, and
# its ufsroot0 device was a second root candidate in IOFindBSDRoot for nothing.
# The OS profile compiles mockfs for the offline fixture, and mockfs_mountroot accepts
# any device: vfs_mountroot tried it before APFS and mounted it as the root. /sbin/launchd
# then was the whole userdata partition (vnode size 108049805312 = 26379347 x 4096) and
# execve returned ENOEXEC on raw APFS bytes. This board roots on APFS, so drop mockfs.
# CONFIG_XNU_SOURCE_MOCKFS is not set
# APFS declines a bdevsw disk with ENOENT (docs/bring-up.md), so the root comes from the
# IOBlockStorageDevice driver instead: KonaUfs publishes the userdata IOMedia. Its imports bind
# to the original IOStorageFamily addresses recorded for the pinned kernelcache
# (scripts/data/storage-bindings.json), which is what lets the archive link.
CONFIG_XNU_NATIVE_UFS=y
# RamBlock publishes the packed Data seed as an IOMedia so APFS can see a Data volume.
CONFIG_XNU_NATIVE_RAM_BLOCK=y
# The owner root chain, in the order scripts/build-xnu-4k-baseline.sh enforces:
#   DATA_MOUNT -> BOOT_MANIFEST -> CACHE_STARTUP -> CACHE_MOUNT -> ROOT_TRUST -> AUDIT -> PROBE.
# The policy itself is policies/verified-root-os (signed from the original OS window of the
# userdata image); the workflow installs it as build/verified-root-os before the kernel step.
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
# The build rejects the boot manifest without the startup block, so this stays on; the experiment
# moves to the bit itself (kebab-route/kona-no-ignition-flag.patch clears dyld_flags bit 3).
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
# The cache carrier instrument is the code that decides whether a dyld shared-cache carrier may
# be mapped (bsd/vm/vm_unix.c, guarded by XNU_OWNER_CACHE_CARRIER && !CONFIG_CSR). Without it the
# stock path runs, the map is refused, dyld finds no cache, and PID 1 ends before main - run BX
# showed cache=0/0 on the page, i.e. the counters were not even compiled in.
CONFIG_XNU_OWNER_CACHE_CARRIER=y
# The cryptex carries System and usr but no /System/Library/Caches/com.apple.dyld (run CE walked it
# one level at a time: System/Library and System/Library/Caches resolve, com.apple.dyld does not),
# so mounting it beside the root leaves dyld with neither a cache nor the library tree. The owner
# mount composes the root as a union when this is on, which is how offline-owner-systemos-mount
# and the cryptex view were written; alioth's record keeps OWNER_CRYPTEX_FILES off for that reason.
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set: RamBlock is this board's verified block transport
# (docs/concepts/security.md records that the two share one policy), so the build accepts it in
# place of the virtio transport that has no device here.
# docs/guide/debugging.md: on a board with no UART the kernel has to report through the
# panel. The boot progress layer renders the diagnostic page that boot-progress=1|2 selects,
# reading the storage counters the KonaUfs component exports.
CONFIG_XNU_BOOT_PROGRESS=y
# No catalog component has Adreno 650 scope yet.
# CONFIG_XNU_NATIVE_ADRENO is not set
