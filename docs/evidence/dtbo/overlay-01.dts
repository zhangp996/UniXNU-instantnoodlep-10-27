/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. kona MTP 19855";
	compatible = "qcom,kona-mtp\0qcom,kona\0qcom,mtp";
	qcom,board-id = <0x10008 0x00>;
	oplus,dtsi_no = <0x4d8f>;
	oplus,pcb_range = <0x00 0x38>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8150@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
					interrupts = <0x00 0x08 0x00 0x03 0x00 0x08 0x01 0x03>;
					interrupt-names = "kpdpwr\0resin";
					qcom,pon-dbc-delay = <0x3d09>;
					qcom,kpdpwr-sw-debounce;
					qcom,system-reset;
					qcom,store-hard-reset-reason;
					qcom,pmicwd;

					qcom,pon_1 {
						qcom,pon-type = <0x00>;
						linux,code = <0x74>;
						qcom,pull-up;
						phandle = <0xb6>;
					};

					qcom,pon_2 {
						qcom,pon-type = <0x01>;
						linux,code = <0x72>;
						qcom,pull-up;
					};
				};

				qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x00 0x24 0x00 0x03>;
					io-channels = <0x01 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x02>;
				};

				clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00 0x200>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x02>;
					clock-output-names = "pm8150_div_clk1\0pm8150_div_clk2";
					clocks = <0xffffffff 0x00>;
					clock-names = "xo";
					phandle = <0xb7>;
				};

				sdam@b100 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb100 0x100>;
					phandle = <0x13>;
				};

				pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xa00>;
					interrupts = <0x00 0xc0 0x00 0x00 0x00 0xc2 0x00 0x00 0x00 0xc5 0x00 0x00 0x00 0xc6 0x00 0x00 0x00 0xc8 0x00 0x00 0x00 0xc9 0x00 0x00>;
					interrupt-names = "pm8150_gpio1\0pm8150_gpio3\0pm8150_gpio6\0pm8150_gpio7\0pm8150_gpio9\0pm8150_gpio10";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x02 0x04 0x05 0x08>;
					phandle = <0x09>;

					key_home {

						key_home_default {
							pins = "gpio1";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0xb8>;
						};
					};

					key_vol_up {

						key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x76>;
						};
					};

					key_vol_down {

						key_vol_down_default {
							pins = "gpio7";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x77>;
						};
					};

					key_confirm {

						key_confirm_default {
							pins = "gpio7";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0xb9>;
						};
					};

					usb2_vbus_boost {

						usb2_vbus_boost_default {
							pins = "gpio9";
							function = "normal";
							output-low;
							power-source = <0x01>;
							phandle = <0xba>;
						};
					};

					usb2_vbus_det {

						usb2_vbus_det_default {
							pins = "gpio10";
							function = "normal";
							input-enable;
							bias-pull-down;
							power-source = <0x01>;
							phandle = <0xbb>;
						};
					};

					dischg_enable {
						pins = "gpio9";
						function = "normal";
						bias-disable;
						power-source = <0x00>;
						output-high;
						qcom,drive-strength = <0x03>;
						phandle = <0x0b>;
					};

					dischg_disable {
						pins = "gpio9";
						function = "normal";
						bias-disable;
						power-source = <0x00>;
						output-low;
						qcom,drive-strength = <0x03>;
						phandle = <0x0c>;
					};

					mps_otg_en_active {
						pins = "gpio3";
						function = "normal";
						bias-disable;
						power-source = <0x00>;
						output-high;
						qcom,drive-strength = <0x03>;
						phandle = <0xbc>;
					};

					mps_otg_en_sleep {
						pins = "gpio3";
						function = "normal";
						bias-disable;
						power-source = <0x00>;
						output-low;
						qcom,drive-strength = <0x03>;
						phandle = <0xbd>;
					};

					mps_otg_en_default {
						pins = "gpio3";
						function = "normal";
						bias-disable;
						power-source = <0x00>;
						output-low;
						qcom,drive-strength = <0x03>;
						phandle = <0xbe>;
					};

					hw_id_active {
						pins = "gpio1";
						function = "normal";
						input-enable;
						bias-pull-up;
						power-source = <0x00>;
						phandle = <0x78>;
					};

					hw_id_sleep {
						pins = "gpio1";
						function = "normal";
						input-enable;
						bias-pull-down;
						power-source = <0x00>;
						phandle = <0x79>;
					};
				};

				qcom,pm8150_rtc {
					compatible = "qcom,pm8941-rtc";
					interrupts = <0x00 0x61 0x01 0x00>;
					phandle = <0xbf>;
				};

				vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x01>;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					vcoin@85 {
						reg = <0x85>;
						label = "vcoin";
						qcom,pre-scaling = <0x01 0x03>;
					};

					xo_therm@4c {
						reg = <0x4c>;
						label = "xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					skin_therm@4d {
						reg = <0x4d>;
						label = "skin_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pa_therm1@4e {
						reg = <0x4e>;
						label = "pa_therm1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x00 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <0x01 0x4c 0x01 0x4d 0x01 0x4e>;
					phandle = <0x81>;

					xo_therm@4c {
						reg = <0x4c>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					skin_therm@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pa_therm1@4e {
						reg = <0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};

			qcom,pm8150@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			pm8150_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x02>;
				wake-capable-sensor;
				phandle = <0xc0>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xc1>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xc2>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8150b@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
					phandle = <0x06>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x02 0x24 0x00 0x03>;
					io-channels = <0x03 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x16>;
				};

				clock-controller@6000 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x6000 0x100>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm8150b_div_clk1";
					clocks = <0xffffffff 0x00>;
					clock-names = "xo";
					phandle = <0xc3>;
				};

				qcom,pbs@7200 {
					compatible = "qcom,qpnp-pbs";
					reg = <0x7200 0x100>;
					phandle = <0x12>;
				};

				qcom,sdam-qnovo@b000 {
					compatible = "qcom,qpnp-qnovo5";
					reg = <0xb000 0x100>;
					interrupts = <0x02 0xb0 0x01 0x01>;
					interrupt-names = "ptrain-done";
					pinctrl-names = "q_state1\0q_state2";
					pinctrl-0 = <0x04>;
					pinctrl-1 = <0x05>;
					phandle = <0xc4>;
				};

				pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xc00>;
					interrupts = <0x02 0xc0 0x00 0x00 0x02 0xc1 0x00 0x00 0x02 0xc4 0x00 0x00 0x02 0xc5 0x00 0x00 0x02 0xc6 0x00 0x00 0x02 0xc7 0x00 0x00 0x02 0xc8 0x00 0x00 0x02 0xc9 0x00 0x00 0x02 0xcb 0x00 0x00>;
					interrupt-names = "pm8150b_gpio1\0pm8150b_gpio2\0pm8150b_gpio5\0pm8150b_gpio6\0pm8150b_gpio7\0pm8150b_gpio8\0pm8150b_gpio9\0pm8150b_gpio10\0pm8150b_gpio12";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x03 0x04 0x0b>;
					phandle = <0x1f>;

					qnovo_fet_ctrl {

						qnovo_fet_ctrl_state1 {
							pins = "gpio8";
							function = "normal";
							input-enable;
							output-disable;
							bias-disable;
							power-source = <0x00>;
							phandle = <0x04>;
						};

						qnovo_fet_ctrl_state2 {
							pins = "gpio8";
							function = "normal";
							input-enable;
							output-disable;
							bias-pull-down;
							power-source = <0x00>;
							phandle = <0x05>;
						};
					};

					smb_stat {

						smb_stat_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							qcom,pull-up-strength = <0x00>;
							power-source = <0x00>;
							phandle = <0xc5>;
						};
					};

					haptics_boost {

						haptics_boost_default {
							pins = "gpio5";
							function = "normal";
							output-enable;
							input-disable;
							bias-disable;
							qcom,drive-strength = <0x03>;
							power-source = <0x01>;
							phandle = <0x20>;
						};
					};

					gpio7_adc {

						gpio7_adc_default {
							pins = "gpio7";
							function = "normal";
							bias-high-impedance;
							phandle = <0x0a>;
						};
					};

					gpio1_adc {

						gpio1_adc_default {
							pins = "gpio1";
							function = "normal";
							bias-high-impedance;
							phandle = <0x0d>;
						};
					};

					gpio8_adc {

						gpio8_adc_default {
							pins = "gpio8";
							function = "normal";
							bias-high-impedance;
							phandle = <0x0e>;
						};
					};
				};

				qcom,qpnp-smb5 {
					compatible = "qcom,qpnp-smb5";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					#cooling-cells = <0x02>;
					qcom,pmic-revid = <0x06>;
					qcom,thermal-mitigation = <0x2dc6c0 0x16e360 0xf4240 0x7a120>;
					qcom,chg-term-src = <0x01>;
					qcom,charger-temp-max = <0x320>;
					qcom,smb-temp-max = <0x320>;
					status = "ok";
					dpdm-supply = <0xffffffff>;
					qcom,sec-charger-config = <0x01>;
					qcom,auto-recharge-soc = <0x62>;
					io-channels = <0x03 0x1e 0x03 0x07 0x03 0x99 0x03 0x83 0x03 0x09 0x03 0x08 0x03 0x30 0x03 0x35>;
					io-channel-names = "mid_voltage\0usb_in_current\0sbux_res\0vph_voltage\0chg_temp\0usb_in_voltage\0usb_temp_adc\0usb_supplementary_temp_adc";
					qcom,battery-data = <0x07>;
					qcom,smb-internal-pull-kohm = <0x00>;
					op,low-voltage-charger;
					qcom,usb-icl-ua = <0x2dc6c0>;
					qcom,fcc-max-ua = <0x2dc6c0>;
					qcom,qc3-disable;
					qcom,hvdcp-disable;
					qcom,float-option = <0x01>;
					qcom,oplus-pps-usbpd-detection = <0x08>;
					qcom,input_current_charger_ma = <0x7d0>;
					qcom,pd_input_current_charger_ma = <0xbb8>;
					qcom,qc_input_current_charger_ma = <0x7d0>;
					qcom,input_current_usb_ma = <0x1f4>;
					qcom,input_current_cdp_ma = <0x5dc>;
					qcom,input_current_led_ma = <0x4b0>;
					qcom,input_current_led_ma_high = <0x708>;
					qcom,input_current_led_ma_warm = <0x708>;
					qcom,input_current_led_ma_normal = <0x7d0>;
					qcom,led_warm_bat_decidegc = <0x15e>;
					qcom,led_high_bat_decidegc = <0x172>;
					qcom,input_current_camera_ma = <0x4b0>;
					qcom,input_current_vooc_led_ma_high = <0x708>;
					qcom,input_current_vooc_led_ma_warm = <0x708>;
					qcom,input_current_vooc_led_ma_normal = <0xe10>;
					qcom,input_current_vooc_ma_normal = <0xe10>;
					qcom,vooc_temp_bat_normal_decidegc = <0x15e>;
					qcom,input_current_vooc_ma_warm = <0xc80>;
					qcom,vooc_temp_bat_warm_decidegc = <0x172>;
					qcom,input_current_vooc_ma_high = <0x898>;
					qcom,vooc_temp_bat_hot_decidegc = <0x1b8>;
					qcom,charger_current_vooc_ma_normal = <0x708>;
					qcom,chg_ctrl_by_calling;
					qcom,input_current_calling_ma = <0x5dc>;
					qcom,overtemp_bat_decidegc = <0x15e>;
					qcom,iterm_disabled = <0x00>;
					qcom,iterm_ma = <0xdc>;
					qcom,recharge-mv = <0x64>;
					qcom,batt_capacity_mah = <0x10e0>;
					qcom,removed_bat_decidegc = <0xbe>;
					qcom,cold_bat_decidegc = <0x14>;
					qcom,temp_cold_vfloat_mv = <0xf8c>;
					qcom,temp_cold_fastchg_current_ma = <0x12c>;
					qcom,little_cold_bat_decidegc = <0x00>;
					qcom,temp_little_cold_vfloat_mv = <0x1153>;
					qcom,temp_little_cold_fastchg_current_ma_high = <0x73a>;
					qcom,temp_little_cold_fastchg_current_ma_low = <0x44c>;
					qcom,temp_little_cold_fastchg_current_ma = <0x44c>;
					qcom,pd_temp_little_cold_fastchg_current_ma_high = <0x73a>;
					qcom,pd_temp_little_cold_fastchg_current_ma_low = <0x44c>;
					qcom,qc_temp_little_cold_fastchg_current_ma_high = <0x4b0>;
					qcom,qc_temp_little_cold_fastchg_current_ma_low = <0x3b6>;
					qcom,cool_bat_decidegc = <0x32>;
					qcom,temp_cool_vfloat_mv = <0x1153>;
					qcom,temp_cool_fastchg_current_ma_high = <0x898>;
					qcom,temp_cool_fastchg_current_ma_low = <0x73a>;
					qcom,pd_temp_cool_fastchg_current_ma_high = <0xa28>;
					qcom,pd_temp_cool_fastchg_current_ma_low = <0x73a>;
					qcom,qc_temp_cool_fastchg_current_ma_high = <0x708>;
					qcom,qc_temp_cool_fastchg_current_ma_low = <0x4b0>;
					qcom,little_cool_bat_decidegc = <0x78>;
					qcom,temp_little_cool_vfloat_mv = <0x1153>;
					qcom,temp_little_cool_fastchg_current_ma = <0x898>;
					qcom,pd_temp_little_cool_fastchg_current_ma = <0xbb8>;
					qcom,qc_temp_little_cool_fastchg_current_ma = <0x7d0>;
					qcom,normal_bat_decidegc = <0xa0>;
					qcom,temp_normal_fastchg_current_ma = <0x898>;
					qcom,temp_normal_vfloat_mv = <0x1153>;
					qcom,pd_temp_normal_fastchg_current_ma = <0xbb8>;
					qcom,qc_temp_normal_fastchg_current_ma = <0x7d0>;
					qcom,warm_bat_decidegc = <0x1c2>;
					qcom,temp_warm_vfloat_mv = <0x1022>;
					qcom,temp_warm_fastchg_current_ma = <0x44c>;
					qcom,pd_temp_warm_fastchg_current_ma = <0x44c>;
					qcom,qc_temp_warm_fastchg_current_ma = <0x44c>;
					qcom,temp_warm_fastchg_current_ma_led_on = <0x1f4>;
					qcom,hot_bat_decidegc = <0x1f4>;
					qcom,non_standard_vfloat_mv = <0xf8c>;
					qcom,non_standard_fastchg_current_ma = <0x200>;
					qcom,short_c_bat_cv_mv = <0x10ea>;
					qcom,short_c_bat_vfloat_mv = <0xed8>;
					qcom,short_c_bat_fastchg_current_ma = <0x200>;
					qcom,cold_vfloat_sw_limit = <0xf8c>;
					qcom,little_cold_vfloat_sw_limit = <0x1121>;
					qcom,cool_vfloat_sw_limit = <0x1121>;
					qcom,little_cool_vfloat_sw_limit = <0x1121>;
					qcom,normal_vfloat_sw_limit = <0x1121>;
					qcom,warm_vfloat_sw_limit = <0xff0>;
					qcom,non_standard_vfloat_sw_limit = <0xf5a>;
					qcom,short_c_bat_vfloat_sw_limit = <0xea6>;
					qcom,max_chg_time_sec = <0x8ca0>;
