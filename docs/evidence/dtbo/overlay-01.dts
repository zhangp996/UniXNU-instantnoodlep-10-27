	fragment@45 {
		target = <0xffffffff>;

		__overlay__ {

			pxlw_iris_gpio {
				phandle = <0x10d>;

				iris_reset_active {
					phandle = <0x2a>;

					mux {
						pins = "gpio174";
						function = "gpio";
					};

					config {
						pins = "gpio174";
						drive-strength = <0x08>;
						bias-disable;
					};
				};

				iris_reset_suspend {
					phandle = <0x2d>;

					mux {
						pins = "gpio174";
						function = "gpio";
					};

					config {
						pins = "gpio174";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				iris_wakeup_active {
					phandle = <0x2b>;

					mux {
						pins = "gpio173";
						function = "gpio";
					};

					config {
						pins = "gpio173";
						drive-strength = <0x08>;
						bias-disable;
					};
				};

				iris_wakeup_suspend {
					phandle = <0x2e>;

					mux {
						pins = "gpio173";
						function = "gpio";
					};

					config {
						pins = "gpio173";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				iris_abyp_ready_active {
					phandle = <0x2c>;

					mux {
						pins = "gpio112";
						function = "gpio";
					};

					config {
						pins = "gpio112";
						drive-strength = <0x08>;
						bias-disable;
					};
				};

				iris_abyp_ready_suspend {
					phandle = <0x2f>;

					mux {
						pins = "gpio112";
						function = "gpio";
					};

					config {
						pins = "gpio112";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				iris_vdd18_active {
					phandle = <0x10e>;

					mux {
						pins = "gpio175";
						function = "gpio";
					};

					config {
						pins = "gpio175";
						drive-strength = <0x08>;
						bias-pull-up;
					};
				};

				iris_vdd18_suspend {
					phandle = <0x10f>;

					mux {
						pins = "gpio175";
						function = "gpio";
					};

					config {
						pins = "gpio175";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};
		};
	};

	fragment@46 {
		target = <0xffffffff>;

		__overlay__ {

			dsi_iris_pwr_supply {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x22>;

				qcom,panel-supply-entry@0 {
					reg = <0x00>;
					qcom,supply-name = "px_v18r";
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-max-voltage = <0x1b7740>;
					qcom,supply-enable-load = <0xf230>;
					qcom,supply-disable-load = <0x50>;
					qcom,supply-post-on-sleep = <0x00>;
				};
			};
		};
	};

	fragment@47 {
		target = <0xffffffff>;

		__overlay__ {

			pxlw,iris {
				compatible = "pxlw,iris";
				index = <0x00>;
				pinctrl-names = "iris_active\0iris_suspend";
				pinctrl-0 = <0x2a 0x2b 0x2c>;
				pinctrl-1 = <0x2d 0x2e 0x2f>;
				qcom,iris-reset-gpio = <0xffffffff 0xae 0x00>;
				qcom,iris-wakeup-gpio = <0xffffffff 0xad 0x00>;
				qcom,iris-abyp-ready-gpio = <0xffffffff 0x70 0x00>;
			};
		};
	};

	fragment@48 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,mdss_dsi_samsung_ana6706_dsc_cmd_2nd {
