							power-source = <0x01>;
							bias-pull-up;
							qcom,pull-up-strength = <0x00>;
							input-enable;
							phandle = <0x87>;
						};

						rf_cable_ant3_active {
							pins = "gpio4";
							function = "normal";
							power-source = <0x01>;
							bias-pull-up;
							qcom,pull-up-strength = <0x00>;
							input-enable;
