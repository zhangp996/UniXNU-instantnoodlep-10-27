							pins = "gpio1";
							function = "normal";
							power-source = <0x00>;
							output-low;
							input-disable;
							phandle = <0xac>;
						};

						cam_sensor_rear_2_ana_suspend {
							pins = "gpio1";
							function = "normal";
							power-source = <0x00>;
							bias-pull-down;
							input-disable;
							phandle = <0xaf>;
						};
					};
				};
			};

			qcom,pm8009@b {
				compatible = "qcom,spmi-pmic";
				reg = <0x0b 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
