// SPDX-License-Identifier: BSD-3-Clause
// OnePlus 8 Pro (instantnoodlep, IN2020 / IN2021 / IN2023 / IN2025), Qualcomm SM8250.
//
// Memory banks, the splash reservation and the enabled peripherals come from the
// phone's own device tree under Android (/proc/device-tree). Values marked REQUIRED
// are still zero here.

/dts-v1/;
/include/ "sm8250.dtsi"

/ {
    model = "OnePlus 8 Pro";
    compatible = "oneplus,instantnoodlep", "qcom,sm8250";

    memory@80000000 {
        device_type = "memory";
        // Measured from this board's live device tree: the stock node carries three
        // banks, 0x80000000+0x3bb00000, 0xc0000000+0xc0000000 and
        // 0x180000000+0x100000000, with the TZ and PIL carveouts between them.
        // scripts/unixnu/devicetree.py requires exactly one contiguous range for the
        // ADT, so the handoff covers the full address span; [payload].dram_size in
        // board.toml must equal this size.
        reg = <0 0x80000000 0x2 0x00000000>;
    };

    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        // Measured: the ABL keeps the panel powered through cont_splash_region at
        // 0x9c000000 with size 0x2300000, and UniXNU receives it as the initrd
        // payload. [bootimg].dtb_node repeats the same pair for the UEFI device tree.
        splash_region: splash_region@9c000000 {
            reg = <0 0x9c000000 0 0x2300000>;
            label = "cont_splash_region";
        };
    };

    //
    // Embedded panic log. XNU's DT patch looks up the top-level "pram" node for its
    // reg and /chosen for embedded-panic-log-size, then writes struct
    // embedded_panic_header plus the panic text there. The address sits inside the
    // firmware's Free Mid span, which MemoryMapLib reserves so nothing else claims it.
    //
    pram@9f400000 {
        reg = <0 0x9f400000 0 0x80000>;
    };

    chosen {
        embedded-panic-log-size = <0x80000>;
    };
};


// Kryo 585: four Cortex-A55 cores and four Cortex-A77 cores in two clusters. The
// scheduler patch runs XNU's Edge scheduler with one E and one P cluster.
&cpu0 { status = "okay"; unixnu,cluster-type = "E"; };
&cpu1 { status = "okay"; unixnu,cluster-type = "E"; };
&cpu2 { status = "okay"; unixnu,cluster-type = "E"; };
&cpu3 { status = "okay"; unixnu,cluster-type = "E"; };
&cpu4 { status = "okay"; unixnu,cluster-type = "P"; };
&cpu5 { status = "okay"; unixnu,cluster-type = "P"; };
&cpu6 { status = "okay"; unixnu,cluster-type = "P"; };
&cpu7 { status = "okay"; unixnu,cluster-type = "P"; };

// Storage: UFS host controller and PHY, used by the ShengUfs transport.
&ufs { status = "okay"; };
&ufsphy { status = "okay"; };

// The A650 GPU path has no catalog component yet, so the GPU, GMU and its SMMU stay
// disabled here. Enabling them needs a component with A650 scope.
